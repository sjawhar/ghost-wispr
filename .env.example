# Ghost Wispr — Environment Variables
# All env vars use the GHOST_WISPR_ prefix.
#
# Provider keys (secrets — env vars only, never in config file). A provider that signs in with a key
# reads it from the variable its auth.env names (providers in ghost-wispr.yaml; README "Model
# providers"). These two are the ones ghost-wispr.yaml.example names, and a config with no providers
# section gets. Add a line for each other api_key provider you name: a GHOST_WISPR_..._API_KEY that
# no provider names is not read, and the start warns.
GHOST_WISPR_DEEPGRAM_API_KEY=your-key-here
GHOST_WISPR_OPENAI_API_KEY=
# The meeting voice's Concierge reads Dispatch with the unit's own token:
GHOST_WISPR_DISPATCH_TOKEN=

# Config file path (optional, defaults to ghost-wispr.yaml)
# GHOST_WISPR_CONFIG=ghost-wispr.yaml

# All other settings live in ghost-wispr.yaml but can be overridden here:
# GHOST_WISPR_DB_PATH=data/ghost-wispr.db
# GHOST_WISPR_AUDIO_DIR=data/audio
# GHOST_WISPR_SILENCE_TIMEOUT=30s
# GHOST_WISPR_MIC_SAMPLE_RATE=16000
# GHOST_WISPR_MIC_SAMPLE_RATES=48000,44100,32000,24000
# GHOST_WISPR_GDRIVE_FOLDER_ID=
# GHOST_WISPR_GOOGLE_CREDENTIALS_FILE=
# GHOST_WISPR_ENVOY_ENABLED=false
# GHOST_WISPR_ENVOY_HUB_URL=http://hub.example.ts.net:9020
# A JSON list of strings, in single quotes so a shell that sources this file keeps its double quotes.
# A settings save in the web UI writes these rules into ghost-wispr.yaml, where they stay after this
# line is removed:
# GHOST_WISPR_RECORDING_RULES='["Anyone can pause the recorder.", "Ask before you quote someone."]'
# The sound card the microphone opens (mic_device), as an ALSA id or a word of its name:
# GHOST_WISPR_MIC_DEVICE=Loopback
# Each role's provider/model, naming a provider of ghost-wispr.yaml (README "Model providers"):
# GHOST_WISPR_TRANSCRIPTION_MODEL=deepgram/nova-3
# GHOST_WISPR_BATCH_TRANSCRIPTION_MODEL=deepgram/nova-3
# GHOST_WISPR_SUMMARIZATION_MODEL=openai/gpt-4o-mini
# GHOST_WISPR_EMBEDDING_MODEL=openai/text-embedding-3-small
# GHOST_WISPR_TTS_MODEL=openai/gpt-4o-mini-tts
# GHOST_WISPR_TTS_VOICE=marin
# GHOST_WISPR_TTS_MAX_LENGTH=5000
# GHOST_WISPR_CONCIERGE_MODEL=vertex/gemini-3.5-flash-lite
# The meeting voice (voice.*, concierge.*; README "Meeting voice"):
# GHOST_WISPR_VOICE_ENABLED=false
# GHOST_WISPR_VOICE_ENGINE=tts
# GHOST_WISPR_CONCIERGE_DISPATCH_URL=https://dispatch.example.test
# GHOST_WISPR_CONCIERGE_ENVOY_URL=http://envoy.example.test:9020

# Listen address (default 127.0.0.1:8080)
# GHOST_WISPR_ADDR=127.0.0.1:8080
