[Unit]
Description=Ghost Wispr release updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# update.sh's steps at their worst, a rollback included, take about 1342 s (its UNIT_LIMIT, which
# deploy/pi/update_test.sh checks against this value).
TimeoutStartSec=30min
WorkingDirectory=/opt/ghost-wispr
ExecStart=/opt/ghost-wispr/update.sh
