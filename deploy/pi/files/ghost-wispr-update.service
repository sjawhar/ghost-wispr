[Unit]
Description=Ghost Wispr release updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# No time limit: a limit's kill can land mid-swap, with the new binary in place and no rollback.
# Each step update.sh waits on has a bound of its own (deploy/pi/update.sh), and
# deploy/pi/update_test.sh checks this is the unit's only time limit.
TimeoutStartSec=infinity
WorkingDirectory=/opt/ghost-wispr
ExecStart=/opt/ghost-wispr/update.sh
