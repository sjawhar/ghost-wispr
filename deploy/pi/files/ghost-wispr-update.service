[Unit]
Description=Ghost Wispr release updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# update.sh's steps at their worst, a rollback included, take about 1840 s, and its rollback's waits
# for a recorder whose state it cannot read about 250 s more (its UNIT_LIMIT, which
# deploy/pi/update_test.sh checks against this value).
TimeoutStartSec=40min
WorkingDirectory=/opt/ghost-wispr
ExecStart=/opt/ghost-wispr/update.sh
