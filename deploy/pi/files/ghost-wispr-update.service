[Unit]
Description=Ghost Wispr release updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# No time limit here: a unit limit's kill could land mid-swap. The launcher runs update.sh under
# timeout --kill-after=60s 45m, the one limit on a whole run, and the next run repairs a swap that
# its kill cut short, since deploy.verified still names the set before. deploy/pi/update_test.sh
# checks this is the unit's only time limit.
TimeoutStartSec=infinity
WorkingDirectory=/opt/ghost-wispr
ExecStart=/opt/ghost-wispr/ghost-wispr-update-launcher.sh
