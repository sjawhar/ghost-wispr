[Unit]
Description=Ghost Wispr continuous transcription
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/ghost-wispr
ExecStartPre=/opt/ghost-wispr/wait-for-network.sh
# A user unit cannot be ordered after the system's time-sync.target: this
# waits for the clock to be synchronized itself, giving up after 120 s.
ExecStartPre=/opt/ghost-wispr/wait-for-time-sync.sh
ExecStart=/opt/ghost-wispr/ghost-wispr
# Longer than both waits together; the user manager's default is 90 s.
TimeoutStartSec=5min
# The user manager's default, set here so the update's restart bound (deploy/pi/update.sh's
# RESTART_WORST) depends on no manager's configuration. update_test.sh requires each timeout here
# set once, in whole seconds or minutes, and each ExecStopPost= under `timeout -k Ns Ms`.
TimeoutStopSec=90s
# Bounded, so a restart is bounded: light-off waits at most 2 s for the light's lock, and a light
# that hangs gets SIGTERM at 10 s and SIGKILL 5 s later, not the stop's own 90 s on top of the
# main process's (deploy/pi/update.sh's RESTART_WORST, which update_test.sh checks).
ExecStopPost=/usr/bin/timeout -k 5s 10s /opt/ghost-wispr/ghost-wispr light-off
EnvironmentFile=/opt/ghost-wispr/.env
Restart=always
RestartSec=10
# The paused listener holds up to 2 s of the room's audio in memory, which
# neither a core dump nor swap may write to disk.
LimitCORE=0
MemorySwapMax=0

[Install]
WantedBy=default.target
