[Unit]
Description=Ghost Wispr continuous transcription
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/ghost-wispr
ExecStartPre=/opt/ghost-wispr/wait-for-network.sh
ExecStart=/opt/ghost-wispr/ghost-wispr
ExecStopPost=/opt/ghost-wispr/ghost-wispr light-off
EnvironmentFile=/opt/ghost-wispr/.env
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
