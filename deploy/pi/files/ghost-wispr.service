[Unit]
Description=Ghost Wispr continuous transcription
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/ghost-wispr
ExecStartPre=/opt/ghost-wispr/wait-for-network.sh
# A user unit cannot be ordered after the system's time-sync.target: this
# waits for the clock to be synchronized itself, giving up after 120 s.
ExecStartPre=/opt/ghost-wispr/wait-for-time-sync.sh
ExecStart=/opt/ghost-wispr/ghost-wispr
# Longer than both waits together; the user manager's default is 90 s.
TimeoutStartSec=5min
ExecStopPost=/opt/ghost-wispr/ghost-wispr light-off
EnvironmentFile=/opt/ghost-wispr/.env
Restart=always
RestartSec=10
# The paused listener holds up to 2 s of the room's audio in memory, which
# neither a core dump nor swap may write to disk.
LimitCORE=0
MemorySwapMax=0

[Install]
WantedBy=default.target
