# shellcheck shell=bash disable=SC2034 # sourced: the deploy scripts and docs/pi-setup.md read these
# The office Pi's deployment settings: its tailnet name and the cloud resources that the scripts in
# deploy/pi and the runbook (docs/pi-setup.md) use for it. Each release carries this file:
# provision.sh and the nightly update (update.sh) read it on the Pi. deploy/pi/files/ghost-wispr.yaml
# is its app config; its public_url, the project of each Vertex AI provider, envoy_hub_url and
# concierge.dispatch_url must agree with PI_HOST, PI_GCP_PROJECT, PI_NATS_SERVER's host and
# PI_DISPATCH_URL (provision_models_test.sh checks). The deploy tests read deploy/pi/test-pi.env
# instead.

# The Pi's tailnet name, and a tailnet tag whose devices must not reach it (slice 1, A5). The
# tailnet policy gives tag:hindsight no grant at all; the Hindsight memory server's pods carry it,
# and docs/pi-setup.md, "Accept slice 1", says how A5 probes from one of them.
PI_HOST=ghost-wispr.tail12ec1c.ts.net
PI_DENIED_TAG=tag:hindsight

# Its Google project, the service account it runs as and that account's unique ID, which its
# tailnet join's Google ID token names as its subject, and the workload identity provider that
# exchanges its X.509 certificate. provision.sh writes the Pi's Google credential files from these.
PI_GCP_PROJECT=theorem-agent-infra
PI_SERVICE_ACCOUNT=ghost-wispr@theorem-agent-infra.iam.gserviceaccount.com
PI_SERVICE_ACCOUNT_UNIQUE_ID=114881075558003314337
PI_WORKLOAD_PROVIDER=projects/805240912354/locations/global/workloadIdentityPools/ghost-wispr/providers/ghost-wispr

# Its Secret Manager secrets in PI_GCP_PROJECT, which the nightly update reads: the device
# certificate, the Deepgram key and the Pi's own Dispatch token. The two secret values are named
# operator-only-, the prefix that holds every box identity off them.
PI_CERTIFICATE_SECRET=ghost-wispr-device-certificate
PI_DEEPGRAM_SECRET=operator-only-ghost-wispr-deepgram-key
PI_DISPATCH_TOKEN_SECRET=operator-only-ghost-wispr-dispatch-token

# The client id of the Pi's Tailscale identity, ghost-wispr-x509, with which provision.sh joins the
# tailnet. The infrastructure's root stack exports it as ghostWisprTailnetClientId.
PI_TAILNET_CLIENT_ID=TWbBfz7fqc11CNTRL-kX7aTA7yJt11CNTRL

# The Envoy NATS hub, where a tailnet member sees the recorder's events. Its listener, on 9020 of
# the same host, takes the recorder's publishes (envoy_hub_url).
PI_NATS_SERVER=nats://envoy-hub.tail12ec1c.ts.net:4222

# The Dispatch server the meeting voice's Concierge reads, where the runbook mints the unit's own
# Dispatch token ("The Pi's secrets").
PI_DISPATCH_URL=https://dispatch.tail12ec1c.ts.net

# The shared drive's second organizer, beside PI_SERVICE_ACCOUNT (slice 2, A10).
PI_DRIVE_OWNER=sami@theorem.dev

# The recordings on the Pi that no deploy step may change, one a line as sha256sum prints them: the
# sha256, two spaces, the path. deploy/pi/check-deploy.sh checks each (check 6); it reads them only
# to hash them.
PI_PROTECTED_RECORDINGS='98c48c4bcfd0e30205636f85891d8d12502c8ff78eb93e527e233d22a3959022  /home/ghost-wispr/meeting-20261112T231548Z.wav
467c50226d957759fe8d8cbd7d67619409ebcf79052f334602e6bf0d1cf345d8  /home/ghost-wispr/meeting-20261113T002018Z-followups.wav'
