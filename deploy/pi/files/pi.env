# shellcheck shell=bash disable=SC2034 # sourced: the deploy scripts and docs/pi-setup.md read these
# The office Pi's deployment settings: its tailnet name and the cloud resources that the scripts in
# deploy/pi and the runbook (docs/pi-setup.md) use for it. deploy/pi/files/ghost-wispr.yaml is its
# app config; its public_url, gcp_project and envoy_hub_url must agree with PI_HOST, PI_GCP_PROJECT
# and PI_NATS_SERVER's host (provision_models_test.sh checks). The deploy tests read
# deploy/pi/test-pi.env instead, through GHOST_WISPR_PI_ENV.

# The Pi's tailnet name, and a tailnet tag whose devices must not reach it (slice 1, A5). The
# tailnet policy gives tag:hindsight no grant at all; the Hindsight memory server's pods carry it,
# and docs/pi-setup.md, "Accept slice 1", says how A5 probes from one of them.
PI_HOST=ghost-wispr.tail12ec1c.ts.net
PI_DENIED_TAG=tag:hindsight

# Its Google project, the service account it runs as, and the workload identity provider that
# exchanges its X.509 certificate.
PI_GCP_PROJECT=theorem-agent-infra
PI_SERVICE_ACCOUNT=ghost-wispr@theorem-agent-infra.iam.gserviceaccount.com
PI_WORKLOAD_PROVIDER=projects/805240912354/locations/global/workloadIdentityPools/ghost-wispr/providers/ghost-wispr

# Its Secret Manager secret in PI_GCP_PROJECT: the device certificate.
PI_CERTIFICATE_SECRET=ghost-wispr-device-certificate

# The Envoy NATS hub, where a tailnet member sees the recorder's events. Its listener, on 9020 of
# the same host, takes the recorder's publishes (envoy_hub_url).
PI_NATS_SERVER=nats://envoy-hub.tail12ec1c.ts.net:4222

# The shared drive's second organizer, beside PI_SERVICE_ACCOUNT (slice 2, A10).
PI_DRIVE_OWNER=sami@theorem.dev

# The infrastructure repository and the checkout the runbook reads it from. Its seed workflow's
# root job prints the Tailscale identity's client ID, and it keeps run logs PI_INFRA_LOG_RETENTION_DAYS
# days. Its root stack's prod configuration holds the service account's unique ID.
PI_INFRA_REPO=theorem-labs/agent-infra
PI_INFRA_CHECKOUT="$HOME/src/agent-infra"
PI_INFRA_LOG_RETENTION_DAYS=90
PI_SEED_WORKFLOW=seed.yaml
PI_SEED_JOB=root
PI_TAILNET_IDENTITY=ghost-wispr-x509
PI_TAILNET_CLIENT_ID_OUTPUT=ghostWisprTailnetClientId
PI_SUBJECT_FILE=root/Pulumi.prod.yaml
PI_SUBJECT_KEY=agent-infra-root:ghostWisprAccountUniqueId
