# shellcheck shell=bash disable=SC2034 # sourced through GHOST_WISPR_PI_ENV
# Neutral deployment settings for the deploy tests, in the shape of deploy/pi/files/pi.env.

PI_HOST=ghost-wispr.example-tailnet.ts.net
PI_DENIED_TAG=tag:example-denied

PI_GCP_PROJECT=example-project
PI_SERVICE_ACCOUNT=ghost-wispr@example-project.iam.gserviceaccount.com
PI_WORKLOAD_PROVIDER=projects/123/locations/global/workloadIdentityPools/ghost-wispr/providers/ghost-wispr

PI_CERTIFICATE_SECRET=example-device-certificate
PI_WEBHOOK_SECRET=example-signing-secret

PI_RELAY_SERVICE_PREFIX=example-relay-
PI_NATS_SERVER=nats://hub.example-tailnet.ts.net:4222

PI_DRIVE_OWNER=owner@example.com

PI_INFRA_REPO=example-org/example-infra
PI_INFRA_CHECKOUT="$HOME/src/example-infra"
PI_INFRA_LOG_RETENTION_DAYS=90
PI_SEED_WORKFLOW=seed.yaml
PI_SEED_JOB=root
PI_TAILNET_IDENTITY=example-x509
PI_TAILNET_CLIENT_ID_OUTPUT=exampleTailnetClientId
PI_SUBJECT_FILE=root/stack.yaml
PI_SUBJECT_KEY=example-root:accountUniqueId
