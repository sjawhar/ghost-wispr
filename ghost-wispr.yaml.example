# Ghost Wispr Configuration
# Copy to ghost-wispr.yaml and customize as needed.
#
# API keys are configured ONLY via environment variables:
#   GHOST_WISPR_DEEPGRAM_API_KEY    (required for live transcription)
#   GHOST_WISPR_OPENAI_API_KEY      (for OpenAI summarization)
#   GHOST_WISPR_ANTHROPIC_API_KEY   (for Anthropic summarization)
#   GHOST_WISPR_GEMINI_API_KEY      (for Gemini summarization)

# Database
db_path: data/ghost-wispr.db

# Audio recording
audio_dir: data/audio
silence_timeout: 30s

# Microphone — preferred sample rate tried first, then alternatives
mic_sample_rate: 16000
mic_sample_rates: [48000, 44100, 32000, 24000]

# Office recorder hardware (both are disabled unless configured)
# indicator_light: blink1
# power_button: true

# Summarization — model format is provider/model_name
summarization:
  model: openai/gpt-4o-mini
  # base_url: ""  # Optional: for OpenAI-compatible endpoints (Ollama, OpenRouter, etc.)

  presets:
    default:
      description: "General-purpose meeting summary with key topics, decisions, and action items"
      system_prompt: "Summarize the following office conversation transcript concisely in markdown. Include key topics, decisions made, and action items if any."
      user_template: "{{transcript}}"

# Google Drive sync (optional)
# gdrive_folder_id:
# google_credentials_file: ./service-account.json
# gdrive_sync_enabled: false

# Garbage collection
# gc_enabled: false
# Delete ended sessions that have a summary (rows, transcripts, audio) older
# than this many days; synced ones only when Drive sync is on. A session
# restored from Drive counts from its restore. 0 = never.
# gc_max_age_days: 30
# Budget for the audio GC may remove: saved recordings of ended sessions,
# synced ones only when Drive sync is on. Past it, GC removes the oldest
# sessions' audio files and keeps the sessions ("Audio removed to free space").
# Raw recordings kept because they could not be saved, and unsynced audio, are
# not counted or removed: GET /api/status reports kept raw recordings.
# 0 = no budget: GC removes no audio to free space.
# A negative value for either is a mistake: the default is used, with a warning.
# gc_max_audio_size_mb: 1024
