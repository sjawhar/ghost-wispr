# Ghost Wispr Configuration
# Copy to ghost-wispr.yaml and customize as needed.
#
# No key is ever in this file: a provider that signs in with a key reads it from the environment
# variable its auth.env names (.env.example). The meeting voice's Concierge reads Dispatch with the
# unit's own token, GHOST_WISPR_DISPATCH_TOKEN.

# Database
db_path: data/ghost-wispr.db

# Audio recording
audio_dir: data/audio
silence_timeout: 30s
# debug, info, warn (or warning) or error, in any case; another value logs at info, with a
# warning. GHOST_WISPR_LOG_LEVEL overrides it for the run only: a settings save in the web UI
# writes this value back, not the variable's.
log_level: info

# The unit's own HTTPS address, such as the name tailscale serve publishes. The web UI accepts
# requests from pages there as well as at the host a request came to, and Envoy events link to
# sessions under it.
# public_url: https://ghost-wispr.example.ts.net

# The rules people in the room agree to. The web UI shows a Recording rules button when there is
# at least one, and its dialog shows each rule as written, as plain text. With none, there is no
# button. GHOST_WISPR_RECORDING_RULES overrides the list with a JSON list of strings; a settings
# save in the web UI then writes the override's rules into this file, where they stay after the
# variable is removed.
# recording_rules:
#   - Say so before the meeting if you do not want it recorded.
#   - Anyone can pause the recorder, at any time.
#   - Ask the office manager to delete a segment.

# Microphone — preferred sample rate tried first, then alternatives
mic_sample_rate: 16000
mic_sample_rates: [48000, 44100, 32000, 24000]
# The sound card the microphone opens, by its ALSA id or a word of its name in
# /proc/asound/cards (GHOST_WISPR_MIC_DEVICE overrides it). Set, no other input
# opens, and no other card counts as the microphone. Unset, the default input.
# mic_device: Jabra

# Office recorder hardware (each is disabled unless configured)
# indicator_light: blink1
# power_button: true
# jabra_mute_button: true

# Model providers (README "Model providers"): each one named once, with the API it speaks, its
# address (url; empty is the API's public address) and how Ghost Wispr signs in to it. Each role
# below names one as provider/model. A file with no providers section gets these two.
providers:
  deepgram:
    api: deepgram
    auth:
      kind: api_key
      env: GHOST_WISPR_DEEPGRAM_API_KEY
  openai:
    api: openai
    auth:
      kind: api_key
      env: GHOST_WISPR_OPENAI_API_KEY
  # The other APIs: anthropic, vertex (Google Vertex AI), gemini (Google's Gemini API), elevenlabs
  # and google-tts (Google Cloud Text-to-Speech). The other sign-ins: google (a Google access
  # token), google_id_token (a Google ID token for an audience, as a model gateway may take) and
  # openai_wif (OpenAI workload identity).
  # gateway:                          # a model gateway that speaks the OpenAI API
  #   api: openai
  #   url: https://gateway.example.test/v1
  #   auth:
  #     kind: google_id_token
  #     audience: example-gateway
  # vertex:
  #   api: vertex
  #   project: example-project
  #   location: global                # or us, eu, or a region such as us-central1
  #   auth:
  #     kind: google
  # anthropic:
  #   api: anthropic
  #   auth:
  #     kind: api_key
  #     env: GHOST_WISPR_ANTHROPIC_API_KEY

# Live transcription, and the pass that transcribes a session's recording again after it ends
# (batch_transcription; "" is transcription.model).
transcription:
  model: deepgram/nova-3
# batch_transcription:
#   model: deepgram/nova-3

# Summaries, titles and speaker names
summarization:
  model: openai/gpt-4o-mini
  # A backlog of sessions goes as one batch job on a Gemini API provider (a Vertex AI provider
  # summarizes online whatever this says); false summarizes each online instead.
  # batch_jobs: true

  presets:
    default:
      description: "General-purpose meeting summary with key topics, decisions, and action items"
      system_prompt: "Summarize the following office conversation transcript concisely in markdown. Include key topics, decisions made, and action items if any."
      user_template: "{{transcript}}"

# Semantic search over the transcripts; "" turns it off.
# embedding:
#   model: openai/text-embedding-3-small

# Text-to-speech, for voice A and POST /api/tts/speak; "" turns it off. voice "" is the model's
# default voice (README "Model providers").
# tts:
#   model: openai/gpt-4o-mini-tts
#   voice: marin
#   max_length: 5000                  # the longest text POST /api/tts/speak takes

# Google Drive, the providers that sign in with Google (auth kinds google, google_id_token and
# openai_wif) and ghost-wispr google-id-token use google_credentials_file. When it is empty,
# Google Application Default Credentials, such as the file GOOGLE_APPLICATION_CREDENTIALS names, are the fallback.
# gdrive_folder_id:
# google_credentials_file: /opt/ghost-wispr/google-credentials.json
# gdrive_sync_enabled: false

# Envoy events (optional): published to the Envoy hub's listener over the tailnet, with no
# credential. With Envoy enabled and no hub URL, no event is sent.
# envoy_enabled: false
# envoy_hub_url: http://hub.example.ts.net:9020

# The meeting voice (README "Meeting voice"), off unless enabled. "Wispr, ..." at the start of a
# sentence asks the Concierge about the work in Dispatch, and the voice speaks the answer through
# the speaker (speaker_enabled). The voice hears the room only while the light reads red.
# voice:
#   enabled: false
#   engine: tts                       # tts (voice A, text-to-speech with tts above), gptlive (voice B, speech-to-speech: OpenAI GPT-Live) or dgagent (voice C, voice agent: Deepgram)
#   wake_phrases: [Wispr, Ghost Wispr]
#   paused_listener: false            # a pause listens for "Wispr, start recording" (a -tags kws build, the Jabra button)
#   gptlive:
#     model: openai/gpt-live-1        # voice B: GPT-Live on an openai provider
#   dgagent:
#     provider: deepgram              # voice C: a deepgram provider, whose key opens the Voice Agent
#     think_model: ""                 # the model that keeps the turn, by Deepgram's own provider/model names; "" is Deepgram's own
# The Concierge: its model on a vertex, gemini or openai provider (a model gateway's OpenAI API
# serves it, such as gateway/claude-haiku-4-5 or gateway/openai/gpt-5-mini), Dispatch with the
# unit's own token (GHOST_WISPR_DISPATCH_TOKEN), and the Envoy listener that relays its questions
# to an issue's agent.
# concierge:
#   model: vertex/gemini-3.5-flash-lite
#   dispatch_url: https://dispatch.example.test
#   envoy_url: http://envoy.example.test:9020

# Garbage collection
# gc_enabled: false
# Delete ended sessions that have a summary (rows, transcripts, audio) older
# than this many days. GC is always Drive-gated: if Drive sync is off, lacks a
# folder, or cannot verify a session, it removes no audio and reports a hold.
# A session restored from Drive counts from its restore. 0 = never.
# gc_max_age_days: 30
# Budget for audio GC. Past it, GC removes the oldest verified Drive-backed
# sessions' audio files and keeps the sessions ("Audio removed to free space").
# Raw recordings kept because they could not be saved, and unverified audio,
# are not counted or removed: GET /api/status reports kept raw recordings.
# 0 = no budget: GC removes no audio to free space.
# A negative value for either is a mistake: the default is used, with a warning.
# gc_max_audio_size_mb: 1024
