# Ghost Wispr Configuration
# Copy to ghost-wispr.yaml and customize as needed.
#
# Google authentication uses google_credentials_file in this YAML first.
# GOOGLE_APPLICATION_CREDENTIALS is the fallback when that key is empty.
# The fallback accepts any Application Default Credential type.
# API keys are configured ONLY via environment variables:
#   GHOST_WISPR_DEEPGRAM_API_KEY    (required for live transcription)
#   GHOST_WISPR_OPENAI_API_KEY      (for OpenAI summarization)
#   GHOST_WISPR_ANTHROPIC_API_KEY   (for Anthropic summarization)
#   GHOST_WISPR_GEMINI_API_KEY      (for Gemini summarization)

# Database
db_path: data/ghost-wispr.db

# Audio recording
audio_dir: data/audio
silence_timeout: 30s

# The unit's own HTTPS address, such as the name tailscale serve publishes. The web UI accepts
# requests from pages there as well as at the host a request came to, and Envoy events link to
# sessions under it.
# public_url: https://ghost-wispr.example.ts.net

# The rules people in the room agree to. The web UI shows a Recording rules button when there is
# at least one, and its dialog shows each rule as written, as plain text. With none, there is no
# button. GHOST_WISPR_RECORDING_RULES overrides the list with a JSON list of strings; a settings
# save in the web UI then writes the override's rules into this file, where they stay after the
# variable is removed.
# recording_rules:
#   - Say so before the meeting if you do not want it recorded.
#   - Anyone can pause the recorder, at any time.
#   - Ask the office manager to delete a segment.

# Microphone — preferred sample rate tried first, then alternatives
mic_sample_rate: 16000
mic_sample_rates: [48000, 44100, 32000, 24000]
# The sound card the microphone opens, by its ALSA id or a word of its name in
# /proc/asound/cards (GHOST_WISPR_MIC_DEVICE overrides it). Set, no other input
# opens, and no other card counts as the microphone. Unset, the default input.
# mic_device: Jabra

# Office recorder hardware (each is disabled unless configured)
# indicator_light: blink1
# power_button: true
# jabra_mute_button: true

# Summarization — model format is provider/model_name
summarization:
  model: openai/gpt-4o-mini
  # base_url: ""  # Optional: for OpenAI-compatible endpoints (Ollama, OpenRouter, etc.)

  presets:
    default:
      description: "General-purpose meeting summary with key topics, decisions, and action items"
      system_prompt: "Summarize the following office conversation transcript concisely in markdown. Include key topics, decisions made, and action items if any."
      user_template: "{{transcript}}"

# Google Drive, Vertex AI, text-to-speech, and ghost-wispr google-id-token use google_credentials_file.
# When it is empty, Google Application Default Credentials are the fallback.
# gdrive_folder_id:
# google_credentials_file: /opt/ghost-wispr/google-credentials.json
# gdrive_sync_enabled: false

# Envoy webhook (optional). Posts are signed with the key Ghost Wispr reads from Secret Manager,
# the secret version below, with google_credentials_file; it reads the key again on a 401. The
# secret version has no default: with Envoy enabled and none named, no event is sent.
# envoy_enabled: false
# envoy_webhook_url: https://relay.example.test/webhook/ghostwispr
# envoy_webhook_secret_name: projects/example-project/secrets/example-signing-secret/versions/latest

# Garbage collection
# gc_enabled: false
# Delete ended sessions that have a summary (rows, transcripts, audio) older
# than this many days. GC is always Drive-gated: if Drive sync is off, lacks a
# folder, or cannot verify a session, it removes no audio and reports a hold.
# A session restored from Drive counts from its restore. 0 = never.
# gc_max_age_days: 30
# Budget for audio GC. Past it, GC removes the oldest verified Drive-backed
# sessions' audio files and keeps the sessions ("Audio removed to free space").
# Raw recordings kept because they could not be saved, and unverified audio,
# are not counted or removed: GET /api/status reports kept raw recordings.
# 0 = no budget: GC removes no audio to free space.
# A negative value for either is a mistake: the default is used, with a warning.
# gc_max_audio_size_mb: 1024
