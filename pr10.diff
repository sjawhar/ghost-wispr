+        {#if newStep === 'describe'}
+          <div class="form-actions">
+            <button class="generate-btn" type="button" onclick={generateFromLLM} disabled={generating || !editDesc.trim()}>
+              {generating ? 'Generating...' : 'Generate with LLM'}
+            </button>
+            <button class="cancel-btn" type="button" onclick={editManually}>
+              Edit manually
+            </button>
+            <button class="cancel-btn" type="button" onclick={() => { expandedPreset = ''; isNew = false }}>
+              Cancel
+            </button>
+            {#if feedback}
+              <span class="feedback error">{feedback}</span>
+            {/if}
+          </div>
+        {:else}
+          <div class="field">
+            <label>System Prompt</label>
+            <textarea rows="6" bind:value={editPrompt}></textarea>
+          </div>
+          <div class="field">
+            <label>User Template</label>
+            <textarea rows="3" bind:value={editTemplate}></textarea>
